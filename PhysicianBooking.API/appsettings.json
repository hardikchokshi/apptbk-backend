{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Secrets are NOT stored here.
  //  - Local machine: dotnet user-secrets (see docs/DEPLOYMENT.md)
  //  - Azure: App Service > Settings > Environment variables
  //      ConnectionStrings__Postgres, GoogleApi__ApiKey,
  //      EmailJsSettings__ServiceId, EmailJsSettings__TemplateId,
  //      EmailJsSettings__PublicKey, EmailJsSettings__PrivateKey
  "GoogleApi": {
    "ApiKey": ""
  },
  "EmailJsSettings": {
    "ServiceId": "",
    "TemplateId": "",
    "PublicKey": "",
    "PrivateKey": ""
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  // Browser origins allowed to call this API.
  // In Azure override with Cors__AllowedOrigins__0, Cors__AllowedOrigins__1, ...
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  // Google import endpoints (/api/GooglePlace/*) call a PAID API. OFF by default.
  // Enable only on Dev/local: Azure env var Features__GooglePlacesImport = true
  "Features": {
    "GooglePlacesImport": false
  },
  "AllowedHosts": "*"
}
